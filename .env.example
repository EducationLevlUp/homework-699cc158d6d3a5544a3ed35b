# API-ключ OpenAI (или совместимого провайдера)
OPENAI_API_KEY=your-api-key-here

# Имя модели (по умолчанию: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# URL для локальной модели (LM Studio / Ollama), если нужно
# LLM_BASE_URL=http://localhost:1234/v1

# Вопрос для агента (по умолчанию задан в коде)
# AGENT_QUERY=Сколько стоит молоко и хлеб в Казани? Сравни цены.
